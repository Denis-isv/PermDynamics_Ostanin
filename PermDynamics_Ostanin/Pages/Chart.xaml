<Page x:Class="PermDynamics_Ostanin.Pages.Chart"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PermDynamics_Ostanin.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Chart">

    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/Images/backgorund.jpg"/>
        </Grid.Background>
        <ScrollViewer x:Name="scroll" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Hidden">
            <Canvas x:Name="canvas" Margin="10,10,10,10" HorizontalAlignment="Left"/>
        </ScrollViewer>
        <Grid Width="200" Height="100" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="10, 0, 0, 10" Background="#7FFFFFFF">
            <Label x:Name="current_value" Content="Тек. знач: " Margin="10,10,10,0" VerticalAlignment="Top"/>
            <Label x:Name="average_value" Content="Сред. знач: " Margin="10,36,10,0" VerticalAlignment="Top"/>
        </Grid>
    </Grid>
</Page>
